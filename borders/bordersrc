#!/bin/bash

# Thin accent-colored border on the focused window, like Hyprland's in
# Omarchy. Colors come from the active theme (sketchybar/colors.sh reads
# ~/.config/theme/current); `theme set` updates the running borders live.
source "$HOME/dotfiles/sketchybar/colors.sh"

borders style=round \
        width=3.0 \
        hidpi=on \
        active_color="$ACCENT_COLOR" \
        inactive_color="$BORDER_INACTIVE"
