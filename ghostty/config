# Colors follow the active theme (`theme set <name>`, see bin/theme).
# The leading ? makes the file optional, so Ghostty still starts before a
# theme has been chosen. Reload after switching: Cmd+Shift+,
config-file = ?~/.config/theme/current/ghostty.conf

font-family = JetBrainsMono Nerd Font Mono
font-size = 14

background-opacity = 0.82
background-blur-radius = 30

cursor-style = bar
cursor-style-blink = true

window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
window-decoration = true

unfocused-split-opacity = 0.7

mouse-hide-while-typing = true

macos-titlebar-style = tabs
